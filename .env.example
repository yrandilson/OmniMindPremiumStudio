# Minimal development environment example for OmniMind Studio
# Copy to .env and edit values before running `pnpm dev`.

# Database (MySQL). Example: mysql://root:pass@127.0.0.1:3306/omnimind
DATABASE_URL=mysql://root:password@127.0.0.1:3306/omnimind

# JWT secret used to sign session cookies
JWT_SECRET=dev-secret

# OAuth / Identity provider (Manus) - set to your provider URL for login to work
OAUTH_SERVER_URL=http://127.0.0.1:3001
VITE_OAUTH_PORTAL_URL=http://127.0.0.1:3001
VITE_APP_ID=dev-app
OWNER_OPEN_ID=dev-owner

# Optional: Analytics (if any)
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=

# Optional third-party API keys used by services (image/llm/tts/storage)
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# MANUS_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=
